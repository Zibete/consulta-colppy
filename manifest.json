{
  "manifest_version": 3,
  "name": "Consulta Colppy",
  "short_name": "Consulta Colppy",
  "version": "2.0.0",
  "description": "Consulta masiva de CUIT, datos y alícuotas mediante la sesión de Colppy.",
  "minimum_chrome_version": "120",
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://login.colppy.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Abrir Consulta Colppy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
